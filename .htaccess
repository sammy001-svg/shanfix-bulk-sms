# Apache .htaccess — BulkSMS Pro
# Place this file in the project root

Options -Indexes
Options -MultiViews

# ── Gzip / Deflate compression ──────────────────────────────────
# Reduces HTML, CSS, JS and JSON transfer sizes by 60-70%
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml text/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/opentype font/woff font/woff2
  # Tell caches that the response varies by Accept-Encoding
  Header append Vary Accept-Encoding
</IfModule>

RewriteEngine On

# ── Force www (optional — uncomment if needed) ──
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Force HTTPS (uncomment in production) ──
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Block direct access to sensitive directories ──
RewriteRule ^(includes|database|\.env|\.git)(/|$) - [F,L]

# ── Pretty directory URLs (optional) ──
# e.g. /admin → /admin/index.php
DirectoryIndex index.php

# ── PHP settings (cPanel / Apache mod_php) ──
# Allow large CSV/Excel uploads (1M+ contacts can be 50–100 MB)
php_value upload_max_filesize 256M
php_value post_max_size 260M
# Web requests that upload files can take a few minutes for large files
php_value max_input_time 600
php_value max_execution_time 300
# Background campaign processing is run via CLI/cron — not subject to this limit
php_value memory_limit 256M

# ── Security headers ──
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# ── Cache static assets (30 days) ──────────────────────────────
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|pdf|webp)$">
  Header set Cache-Control "public, max-age=2592000, immutable"
</FilesMatch>

# ── Block access to .htaccess itself ──
<Files ".htaccess">
  Order Allow,Deny
  Deny from all
</Files>
